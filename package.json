{
  "dependencies": {
    "@portabletext/to-html": "^6.0.0",
    "@sanity/webhook": "^4.0.4",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "@portabletext/block-tools": "^6.0.4",
    "@sanity/schema": "^6.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1"
  },
  "name": "ismailahmad-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
