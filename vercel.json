{
  "rewrites": [
    {
      "source": "/:slug([a-z0-9]+(?:-[a-z0-9]+)*)",
      "has": [
        {
          "type": "host",
          "value": "blog.ismailahmad.com"
        }
      ],
      "destination": "/api/posts?render=article&slug=:slug"
    },
    {
      "source": "/work/:slug",
      "destination": "/case"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/posts?render=article&slug=:slug"
    },
    {
      "source": "/personal/:slug",
      "destination": "/personal"
    }
  ],
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/writing/:slug",
      "has": [
        {
          "type": "host",
          "value": "blog.ismailahmad.com"
        }
      ],
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "host",
          "value": "blog.ismailahmad.com"
        }
      ],
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/writing",
      "has": [
        {
          "type": "host",
          "value": "blog.ismailahmad.com"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "host",
          "value": "blog.ismailahmad.com"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/profile",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "archives.ismailahmad.com"
        }
      ],
      "destination": "https://www.ismailahmad.com/archive",
      "permanent": true
    },
    {
      "source": "/writing",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/writing/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "functions": {
    "api/posts.js": {
      "includeFiles": "*.html"
    },
    "api/case-access.js": {
      "includeFiles": "assets/pdf/**"
    }
  }
}
