{
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/about"
    },
    {
      "source": "/work/:slug",
      "destination": "/case"
    },
    {
      "source": "/writing",
      "destination": "/blog"
    },
    {
      "source": "/writing/:slug",
      "destination": "/post"
    }
  ],
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
